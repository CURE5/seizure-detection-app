# Dashboard configuration. Copy to .env (git-ignored) and adjust.
# NEXT_PUBLIC_* values are baked into the browser bundle at build time.

# Port the Node/Next server (server.js) listens on
NEXT_PUBLIC_NEXT_PORT=3000

# Where the Python detection server runs, as seen from THIS process.
# server.js proxies /proxy/* to http://<FASTAPI_IP>:<FASTAPI_PORT>/*
NEXT_PUBLIC_FASTAPI_IP=localhost
NEXT_PUBLIC_FASTAPI_PORT=8000

# Browser-side URLs.
#   NEXT_PUBLIC_NEXT_URL         base URL of this app (empty = same origin)
#   NEXT_PUBLIC_PROXY_URL        path prefix the browser uses to reach the Python API
#   NEXT_PUBLIC_NEXT_SOCKET_URL  WebSocket URL of the Python server, as reachable
#                                from the browser (through your tunnel/reverse proxy)
NEXT_PUBLIC_NEXT_URL=
NEXT_PUBLIC_PROXY_URL=/proxy
NEXT_PUBLIC_NEXT_SOCKET_URL=ws://localhost:8000/ws

# Optional shared secret for the reboot / shutdown / PM2 control endpoints.
# Set both to the same random string to require it; leave unset to disable.
# PM2_API_KEY=change-me
# NEXT_PUBLIC_PM2_API_KEY=change-me
